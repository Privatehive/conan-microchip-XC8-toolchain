# Generates a CLion custom compiler definition for XC8 and the selected device: ${CMAKE_BINARY_DIR}/xc8-clion.yaml
#
# CLion can't query xc8-cc for its predefined macros and include paths (it probes compilers it identifies as
# GCC/Clang with GCC-style options, which xc8-cc rejects). Register the generated file once in
# Settings | Build, Execution, Deployment | Toolchains | Custom Compiler ("Use custom compiler config").
# See https://www.jetbrains.com/help/clion/custom-compilers.html
#
# The macros and include paths are taken from the clang front end that xc8-cc runs internally.

include_guard()

function(_xc8_generate_clion_config)
    set(work_dir "${CMAKE_BINARY_DIR}/CMakeFiles/xc8-clion")
    set(yaml_file "${CMAKE_BINARY_DIR}/xc8-clion.yaml")
    file(MAKE_DIRECTORY "${work_dir}")
    file(WRITE "${work_dir}/probe.c" "")

    # 1) Let the driver print the command line of its internal clang front end
    execute_process(
        COMMAND "${CMAKE_C_COMPILER}" -mcpu=${XC8_MCU} -mdfp=${XC8_DFP} -v -c probe.c -o probe.p1
        WORKING_DIRECTORY "${work_dir}"
        OUTPUT_VARIABLE output ERROR_VARIABLE output RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT output MATCHES "/pic/bin/clang [^\n]*\\[ ([^\n]*) \\]")
        message(WARNING "XC8: Couldn't determine the clang front end arguments, ${yaml_file} not generated")
        return()
    endif()
    separate_arguments(args UNIX_COMMAND "${CMAKE_MATCH_1}")
    list(FILTER args EXCLUDE REGEX "^(probe\\.c|-oprobe\\.p1|-S|-MMD|-MF.*)$")

    # 2) Run the front end with the same arguments to dump all predefined macros
    #    (including the ones of language_support.h, which XC8 force-includes)
    execute_process(
        COMMAND "${XC8_ROOT}/pic/bin/clang" ${args} -dM -E probe.c
        WORKING_DIRECTORY "${work_dir}"
        OUTPUT_VARIABLE macros ERROR_QUIET RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(WARNING "XC8: Couldn't dump the predefined macros, ${yaml_file} not generated")
        return()
    endif()
    string(STRIP "${macros}" macros)
    # XC8's headers use attributes and assembler statements everywhere, directly (e.g. SLEEP() is __asm("sleep")) and
    # via the macros of language_support.h (e.g. "extern volatile unsigned char PORTA __at(0x00C);" in the device
    # headers). CLion doesn't know the GNU keywords __attribute__ and __asm for this compiler and fails to parse such
    # declarations and statements. They don't matter for code insight, so they expand to nothing for CLion.
    string(APPEND macros "\n#define __attribute__(x)\n#define __asm(...)")
    string(REPLACE "\n" "\n      " macros "${macros}")

    set(include_dirs "")
    foreach(arg IN LISTS args)
        if(arg MATCHES "^-isystem(.+)$")
            string(APPEND include_dirs "      - \"${CMAKE_MATCH_1}\"\n")
        endif()
    endforeach()

    # 8-bit PIC isn't a clang target: avr is the closest one (little endian, 16-bit int and pointers, 32-bit long).
    # XC8's own front end knows additional types (mapped to the closest standard type) and type qualifiers
    # (defined empty) that are unknown to CLion.
    file(WRITE "${yaml_file}" "\
# CLion custom compiler definition for MPLAB XC8 and ${XC8_MCU}. Generated by xc8-clion.cmake, don't edit.
compilers:
  - description: \"MPLAB XC8 C compiler (${XC8_MCU})\"
    match-compiler-exe: \"(.*/)?xc8-cc(\\\\.exe)?\"
    match-language: C
    code-insight-target-name: avr
    include-dirs:
${include_dirs}\
    defines:
      __bit: _Bool
      __int24: long
      __uint24: unsigned long
      __far:
      __near:
      __persistent:
      __eeprom:
      __pack:
      __discrete:
      __rom:
      __ram:
      __bank0:
      __bank1:
      __bank2:
      __bank3:
      __low_priority:
      __high_priority:
    defines-text: |
      ${macros}
")
    message(STATUS "XC8: CLion custom compiler definition: ${yaml_file}")
endfunction()

_xc8_generate_clion_config()
